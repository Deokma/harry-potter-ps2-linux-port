# Device connection for scripts/deploy.sh and scripts/run_remote.sh.
# Copy to .env (git-ignored) and adjust. Variables already set in the
# environment win over this file.

# SSH login on the handheld (key login only: the scripts never prompt)
BENCH_HOST=root@192.168.0.165
# Working directory on the device, relative to the login's home
BENCH_DIR=ps2bench
# Extra ssh options, e.g. the dedicated key (Git Bash path syntax)
BENCH_SSH_OPTS=-i /c/Users/<you>/.ssh/ps2port_ed25519 -o IdentitiesOnly=yes

# Knulli / Batocera: root's home is on exFAT, so dropbear refuses keys on
# port 22. Start the key-login SSH on 2222 once per boot with
# scripts/device_ssh_setup.sh, then use instead:
# BENCH_SSH_OPTS=-p 2222 -i /c/Users/<you>/.ssh/ps2port_ed25519 -o IdentitiesOnly=yes
# BENCH_DIR=/userdata/ps2bench

# Firmware-specific: stop the frontend before bench_gl, restart it after
# BENCH_PRE=
# BENCH_POST=
# BENCH_ENV=SDL_VIDEODRIVER=kmsdrm
