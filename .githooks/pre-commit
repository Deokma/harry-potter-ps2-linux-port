#!/bin/sh
# Second line of defence behind .gitignore: refuse to commit anything that
# looks like game data (disc images, ELFs, CHDs) or any large binary.
# Enable once per clone:  git config core.hooksPath .githooks

max_bytes=2097152   # 2 MiB; source files and docs are far below this

git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
    size=$(git cat-file -s ":$f")
    if [ "$size" -gt "$max_bytes" ]; then
        echo "pre-commit: blocked '$f' ($size bytes > $max_bytes)" >&2
        exit 1
    fi
    head4=$(git cat-file blob ":$f" 2>/dev/null | head -c 4)
    head8=$(git cat-file blob ":$f" 2>/dev/null | head -c 8)
    if [ "$head4" = "$(printf '\177ELF')" ]; then
        echo "pre-commit: blocked '$f' (ELF binary)" >&2
        exit 1
    fi
    if [ "$head8" = "MComprHD" ]; then
        echo "pre-commit: blocked '$f' (CHD disc image)" >&2
        exit 1
    fi
    if [ "$size" -gt 32773 ] && \
       [ "$(git cat-file blob ":$f" 2>/dev/null | head -c 32774 | tail -c 5)" = "CD001" ]; then
        echo "pre-commit: blocked '$f' (ISO9660 image)" >&2
        exit 1
    fi
done || exit 1
